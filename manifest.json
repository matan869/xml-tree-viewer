{
  "manifest_version": 3,
  "name": "XML Viewer: Tree, Table, JSON, E-Invoice",
  "version": "1.2.0",
  "description": "Read any XML: collapsible tree, sortable table, XML to JSON, CSV export, XPath. Opens UBL/XRechnung/FatturaPA invoices & camt.053.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "XML Viewer & Formatter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/*",
        "file:///*"
      ],
      "js": [
        "src/xml.js",
        "src/features.js",
        "src/docs.js",
        "src/tree.js",
        "src/detect.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}