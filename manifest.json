{
  "manifest_version": 3,
  "name": "XML Viewer & Formatter – Tree, XPath",
  "version": "1.1.0",
  "description": "XML as a collapsible tree, sortable table or JSON. XPath, CSV export, pretty print, dark mode. Offline, free, no tracking.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "XML Viewer & Formatter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/*",
        "file:///*"
      ],
      "js": [
        "src/xml.js",
        "src/features.js",
        "src/tree.js",
        "src/detect.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}