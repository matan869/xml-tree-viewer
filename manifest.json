{
  "manifest_version": 3,
  "name": "JSON & XML Viewer and Formatter",
  "version": "2.0.0",
  "description": "Formats JSON and XML as a collapsible tree, a sortable table or raw text. No ads, no tracking, zero network requests. Open source.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JSON & XML Viewer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/*",
        "file:///*"
      ],
      "js": [
        "src/xml.js",
        "src/features.js",
        "src/docs.js",
        "src/tree.js",
        "src/json.js",
        "src/jsontree.js",
        "src/detect.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
